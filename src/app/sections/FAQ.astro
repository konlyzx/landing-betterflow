---
const faqs = [
  {
    q: "What is Better Flow?",
    a: "Better Flow is a free, open-source screenshot studio that runs entirely in your browser. It transforms raw screenshots into production-ready visuals with browser frames, 3D effects, animations, and backgrounds. No sign-up, no data uploads, and no server roundtrips — all processing happens locally.",
  },
  {
    q: "Is Better Flow free?",
    a: "Yes. Better Flow is completely free and open source under the Apache 2.0 license. There are no paid tiers, subscriptions, or usage limits. You can use the web app or fork and self-host the code from GitHub.",
  },
  {
    q: "Does Better Flow upload my screenshots to a server?",
    a: "No. All editing happens locally in your browser using the HTML5 Canvas API, Konva, and FFmpeg WASM. Your screenshots never leave your device. There is zero telemetry and no server roundtrips during editing or export.",
  },
  {
    q: "What file formats can Better Flow export?",
    a: "Better Flow exports PNG and JPG images at up to 5x scale (4K quality), animated MP4 and WebM video files, and GIF animations. All exports are generated locally in your browser.",
  },
  {
    q: "How is Better Flow different from Shots.so, Screely, or Pika?",
    a: "Better Flow is open source (Apache 2.0) and processes everything locally — no uploads, no accounts, no telemetry. Unlike Shots.so, Screely, or Pika, it supports video animation export (MP4, WebM, GIF), a timeline editor, and 3D perspective transforms. It is also completely free with no paid tier.",
  },
  {
    q: "What browser mockup styles does Better Flow support?",
    a: "Better Flow supports Safari and Chrome browser frame mockups, Arc browser style, Polaroid frames, glass frames, and outline device frames. It also includes 3D perspective transforms, depth shadows, and over 100 background styles including gradients, noise, and mesh patterns.",
  },
];
---

<section id="faq" class="relative z-10 px-6 py-24">
  <div class="mx-auto max-w-[1324px]">
    <div class="faq-reveal mb-8">
      <h2 style="font-family:Geist, sans-serif;font-size:32px;font-weight:500;color:#fff;letter-spacing:-0.02em;margin:0">Frequently asked questions</h2>
    </div>

    <div class="faq-grid">
      {faqs.map((item, i) => (
        <div class="faq-item faq-card" data-index={i}>
          <button
            class="faq-trigger"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            id={`faq-btn-${i}`}
          >
            <span class="faq-question">{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            </span>
          </button>
          <div
            id={`faq-answer-${i}`}
            role="region"
            aria-labelledby={`faq-btn-${i}`}
            class="faq-answer"
            hidden
          >
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .faq-item {
    background: #131316;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition: border-top-color 0.3s ease;
  }
  .faq-item::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 1px;
    width: 150px;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent 0%, rgba(143,143,143,0.67) 50%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .faq-item::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    height: 300px;
    width: 320px;
    transform: translate(-50%, -50%);
    background: conic-gradient(from 90deg at 50% 50%, transparent 50%, #131316 50%), radial-gradient(rgba(201,221,255,0.1) 0%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .faq-item:hover {
    border-top-color: rgba(255, 255, 255, 0.18);
  }
  .faq-item.is-open {
    border-top-color: rgba(201, 212, 255, 0.25);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    position: relative;
    z-index: 1;
  }
  .faq-question {
    font-family: 'Geist Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .faq-icon {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.35);
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
    color: rgba(201, 212, 255, 0.7);
  }

  .faq-answer {
    padding: 0 22px 20px;
    position: relative;
    z-index: 1;
  }
  .faq-answer p {
    font-family: 'Geist Sans', sans-serif;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 14px;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    ".faq-reveal",
    { opacity: 0, y: 20 },
    { opacity: 1, y: 0, duration: 0.5, ease: "power2.out", scrollTrigger: { trigger: ".faq-reveal", start: "top 90%" } }
  );

  gsap.utils.toArray<HTMLElement>(".faq-card").forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 20 }, {
      opacity: 1, y: 0, duration: 0.4, delay: i * 0.05, ease: "power2.out",
      scrollTrigger: { trigger: el, start: "top 92%" },
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".faq-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest<HTMLElement>(".faq-item")!;
      const answer = item.querySelector<HTMLElement>(".faq-answer")!;
      const isOpen = item.classList.contains("is-open");

      if (isOpen) {
        item.classList.remove("is-open");
        btn.setAttribute("aria-expanded", "false");
        gsap.to(answer, { height: 0, opacity: 0, duration: 0.25, ease: "power2.in", onComplete: () => { answer.hidden = true; answer.style.height = ""; } });
      } else {
        answer.hidden = false;
        const fullHeight = answer.scrollHeight;
        gsap.fromTo(answer, { height: 0, opacity: 0 }, { height: fullHeight, opacity: 1, duration: 0.3, ease: "power2.out", onComplete: () => { answer.style.height = "auto"; } });
        item.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
