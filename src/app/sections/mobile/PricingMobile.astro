---
const plans = [
  {
    name: "Open",
    badge: "Free & Open Source",
    price: "$0",
    period: "forever",
    cta: "Start Creating",
    href: "https://app.betterflow.site",
    features: [
      "Unlimited projects",
      "4K PNG, MP4 & GIF export",
      "Browser mockups & 3D effects",
      "Open source (Apache 2.0)",
    ],
  },
  {
    name: "Cloud",
    badge: "BetterFlow Cloud",
    price: "$10",
    period: "month",
    cta: "Get Notified",
    href: "mailto:hello@betterflow.site?subject=Cloud%20Plan%20Interest",
    features: [
      "Everything in Open",
      "Cloud-synced projects",
      "Version history",
      "Extended cloud storage",
      "Collections & folders",
      "Team collaboration",
      "Priority support",
    ],
  },
];
---

<section class="relative z-10 px-6 py-20" style="background:#0b0b0c">
  <div class="pricingm-reveal mb-10 text-center">
    <h2 class="text-[26px] font-semibold tracking-tight text-white" style="font-family:Geist, sans-serif;margin:0 0 8px 0">Simple pricing</h2>
    <p class="mx-auto max-w-[360px] text-sm leading-relaxed text-[#71717a]">Free and open source. Cloud services coming soon.</p>
  </div>

  <div class="pricingm-grid">
    {plans.map((plan) => (
      <div class="pricingm-card">
        <div class="pricingm-badge">{plan.badge}</div>
        <h3 class="pricingm-name">{plan.name}</h3>
        <div class="pricingm-price-row">
          <span class="pricingm-price">{plan.price}</span>
          <span class="pricingm-period">/{plan.period}</span>
        </div>
        <a href={plan.href} class="pricingm-cta">
          {plan.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <ul class="pricingm-features">
          {plan.features.map((f) => (
            <li class="pricingm-feature">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .pricingm-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pricingm-card {
    background: #131316;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    transition: border-top-color 0.3s ease;
  }
  .pricingm-card::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 1px;
    width: 120px;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent 0%, rgba(143,143,143,0.67) 50%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .pricingm-card::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    height: 240px;
    width: 260px;
    transform: translate(-50%, -50%);
    background: conic-gradient(from 90deg at 50% 50%, transparent 50%, #131316 50%), radial-gradient(rgba(201,221,255,0.1) 0%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .pricingm-card:hover {
    border-top-color: rgba(255, 255, 255, 0.18);
  }

  .pricingm-badge {
    display: inline-flex;
    font-size: 10px;
    font-weight: 500;
    color: #ff9a66;
    background: rgba(255,126,64,0.08);
    border: 1px solid rgba(255,126,64,0.15);
    border-radius: 50px;
    padding: 3px 10px;
    margin-bottom: 12px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    width: fit-content;
    position: relative;
    z-index: 1;
  }
  .pricingm-name {
    font-family: 'Geist Sans', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 4px 0;
    position: relative;
    z-index: 1;
  }
  .pricingm-price-row {
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }
  .pricingm-price {
    font-family: 'Geist Sans', sans-serif;
    font-size: 30px;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .pricingm-period {
    font-size: 12px;
    color: rgba(255,255,255,0.35);
  }
  .pricingm-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background: rgba(255,255,255,0.06);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 18px;
    position: relative;
    z-index: 1;
    transition: background 0.2s;
  }
  .pricingm-cta:active {
    background: rgba(255,255,255,0.12);
  }
  .pricingm-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .pricingm-feature {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: rgba(255,255,255,0.65);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  gsap.fromTo(".pricingm-reveal", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out", scrollTrigger: { trigger: ".pricingm-reveal", start: "top 92%" } });
  gsap.utils.toArray<HTMLElement>(".pricingm-card").forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.35, delay: i * 0.08, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 92%" } });
  });
</script>
