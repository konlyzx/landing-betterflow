import CommunityHero from "@/app/components/community/Hero.astro";
import Manifesto from "@/app/components/community/Manifesto.astro";
import OpenSource from "@/app/components/community/OpenSource.astro";
import Activity from "@/app/components/community/Activity.astro";
import ContributionFlow from "@/app/components/community/ContributionFlow.astro";
