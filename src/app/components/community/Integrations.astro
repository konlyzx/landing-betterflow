---
import SpotlightCard from "@/app/components/ui/SpotlightCard.astro";

const cardStyle = "background:#131316;border:none;border-top:1px solid rgba(255, 255, 255, 0.08);border-radius:24px";
const FEATURES = [
  { icon: '<circle cx="12" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="6" r="3"></circle><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path><path d="M12 12v3"></path>', title: "Fork & contribute", description: "Clone the repo, make your changes, and submit a pull request. It's that simple." },
  { icon: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>', title: "Star & follow", description: "Show your support and stay updated with releases, discussions, and community highlights." },
  { icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>', title: "Join the community", description: "Engage with maintainers and contributors through issues, discussions, and PR reviews." },
];
const cols = Array.from({ length: 0 });
---

<section class="relative z-10 overflow-hidden px-6 py-24">
  <div class="mx-auto max-w-[1324px]">
    <div class="grid items-start gap-12 md:grid-cols-2 md:gap-20">
      <div class="ig-left">
        <div style="margin-bottom:32px">
          <h2 style="font-family:Geist, sans-serif;font-size:32px;font-weight:500;color:#fff;letter-spacing:-0.02em;margin:0">Powered by <span style="color:rgba(255,255,255,0.5)">GitHub</span></h2>
        </div>
        <p style="font-family:'Geist Sans', sans-serif;font-size:13px;line-height:1.55;color:rgba(255, 255, 255, 0.6);margin:0 0 32px;max-width:440px">Built with GitHub integration from day one. Sign in, contribute, and collaborate — all through the open-source platform you already trust.</p>

        <div class="flex flex-col gap-4">
          {FEATURES.map((feature) => (
            <div class="ig-feature">
              <SpotlightCard class="rounded-2xl border-transparent bg-transparent p-4" style={cardStyle}>
                <div class="flex items-start gap-3">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0" style="color:rgba(255, 255, 255, 0.3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon}></svg>
                  <div>
                    <h4 style="font-family:'Geist Sans', sans-serif;font-size:14px;font-weight:600;color:rgba(255,255,255,0.8);margin:0 0 4px;letter-spacing:-0.01em">{feature.title}</h4>
                    <p style="font-family:'Geist Sans', sans-serif;font-size:13px;line-height:1.55;color:rgba(255, 255, 255, 0.6);margin:0">{feature.description}</p>
                  </div>
                </div>
              </SpotlightCard>
            </div>
          ))}
        </div>
      </div>

      <div class="ig-logo flex flex-col items-center justify-start mt-48 gap-6">
        <div class="relative flex h-24 w-24 items-center justify-center rounded-3xl md:h-32 md:w-32" style={cardStyle}>
          <div class="h-16 w-16 md:h-24 md:w-24" style="color:rgba(255, 255, 255, 0.15)">
            <img src="/logo.svg" alt="Better SpaceX Logo" class="h-full w-full">
          </div>
        </div>

        <!-- Repo preview -->
        <a
          href="https://github.com/betterspacx"
          target="_blank"
          rel="noopener noreferrer"
          class="ig-repo group block w-full max-w-md rounded-2xl p-5 transition-all duration-300 hover:scale-[1.02]"
          style={cardStyle}
        >
          <div class="flex items-center gap-3" style="margin-bottom:16px">
            <svg class="h-5 w-5 flex-shrink-0" style="color:rgba(255,255,255,0.4)" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
            <span style="font-family:'Geist Sans', sans-serif;font-size:14px;font-weight:600;color:rgba(255,255,255,0.8);letter-spacing:-0.01em">betterspacx/better-flow</span>
          </div>
          <p style="font-family:'Geist Sans', sans-serif;font-size:13px;line-height:1.55;color:rgba(255,255,255,0.5);margin:0 0 16px">An open-source screenshot studio and browser tool. Transform raw captures into production-ready graphics instantly.</p>
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-3 w-3 rounded-full" style="background:#3178c6"></span>
              <span style="font-family:'Geist Sans', sans-serif;font-size:12px;color:rgba(255,255,255,0.4)">TypeScript</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" style="color:rgba(255,255,255,0.3)" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              <span style="font-family:'Geist Sans', sans-serif;font-size:12px;color:rgba(255,255,255,0.4)">Stars</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" style="color:rgba(255,255,255,0.3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path><path d="M12 12v3"></path></svg>
              <span style="font-family:'Geist Sans', sans-serif;font-size:12px;color:rgba(255,255,255,0.4)">Forks</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>(".ig-left").forEach((el) => {
    gsap.fromTo(el, { opacity: 0, x: -30 }, { opacity: 1, x: 0, duration: 0.7, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 88%" } });
  });
  document.querySelectorAll<HTMLElement>(".ig-logo").forEach((el) => {
    gsap.fromTo(el, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 88%" } });
  });
  document.querySelectorAll<HTMLElement>(".ig-repo").forEach((el) => {
    gsap.fromTo(el, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, delay: 0.2, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 90%" } });
  });
  gsap.utils.toArray<HTMLElement>(".ig-feature").forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, delay: i * 0.15, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 92%" } });
  });
</script>
