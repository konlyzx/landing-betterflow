---
import SpotlightCard from "@/app/components/ui/SpotlightCard.astro";

const cardStyle = "background:#131316;border:none;border-top:1px solid rgba(255, 255, 255, 0.08);border-radius:24px;padding:0";
const githubIcon = '<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>';
const SECTIONS = [
  { id: "discussions", icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>', title: "Recent Discussions", emptyTitle: "No discussions yet", emptyDesc: "Start the first conversation about features, ideas, or improvements.", emptyIcon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>' },
  { id: "issues", icon: githubIcon, iconFill: true, title: "Latest Issues", emptyTitle: "No open issues", emptyDesc: "Be the first to report a bug or suggest an enhancement.", emptyIcon: githubIcon, emptyIconFill: true },
  { id: "roadmap", icon: '<circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle>', title: "Roadmap", emptyTitle: "Planning in progress", emptyDesc: "The roadmap is being shaped by early community input.", emptyIcon: '<circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle>' },
  { id: "feed", icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>', title: "Community Feed", emptyTitle: "Waiting for activity", emptyDesc: "Be the first contributor and your activity will appear here.", emptyIcon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>' },
];
---

<section class="relative z-10 overflow-hidden px-6 py-24">
  <div class="mx-auto max-w-[1324px]">
    <div class="ac-reveal" style="margin-bottom:32px">
      <h2 style="font-family:Geist, sans-serif;font-size:32px;font-weight:500;color:#fff;letter-spacing:-0.02em;margin:0">See what the community <span style="color:rgba(255,255,255,0.5)">is building.</span></h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(12, 1fr);gap:16px">
      {SECTIONS.map((section) => (
        <div class="ac-card" style="grid-column:span 12">
          <SpotlightCard class="overflow-hidden rounded-2xl border-transparent bg-transparent" style={cardStyle}>
            <div class="flex items-center justify-between px-6 py-4" style="border-bottom:1px solid rgba(255, 255, 255, 0.04)">
              <div class="flex items-center gap-2.5">
                <svg class="h-4 w-4" style="color:rgba(255, 255, 255, 0.3)" viewBox="0 0 24 24" fill={section.iconFill ? "currentColor" : "none"} stroke={section.iconFill ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={section.icon}></svg>
                <h3 style="font-family:'Geist Sans', sans-serif;font-size:15px;font-weight:600;color:#fff;margin:0;letter-spacing:-0.01em">{section.title}</h3>
              </div>
              <span class="rounded-full px-2 py-0.5 text-xs" style="background:rgba(255, 255, 255, 0.04);color:rgba(255, 255, 255, 0.25)">Coming soon</span>
            </div>
            <div class="flex flex-col items-center px-4 py-12 text-center">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl" style="background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.05)">
                <svg class="h-5 w-5" style="color:rgba(255, 255, 255, 0.2)" viewBox="0 0 24 24" fill={section.emptyIconFill ? "currentColor" : "none"} stroke={section.emptyIconFill ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={section.emptyIcon}></svg>
              </div>
              <h4 style="font-family:'Geist Sans', sans-serif;font-size:14px;font-weight:600;color:rgba(255,255,255,0.5);margin:0 0 4px">{section.emptyTitle}</h4>
              <p style="font-family:'Geist Sans', sans-serif;font-size:13px;line-height:1.55;color:#52525b;max-width:200px;margin:0">{section.emptyDesc}</p>
            </div>
          </SpotlightCard>
        </div>
      ))}
    </div>

    <div class="ac-reveal mt-10 flex justify-center">
      <a href="https://github.com/betterspacx" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-medium transition-colors duration-200" style="color:rgba(255, 255, 255, 0.4)">
        View all activity on GitHub
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .ac-card { grid-column: span 6 !important; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .ac-card { grid-column: span 6 !important; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>(".ac-reveal").forEach((el) => {
    gsap.fromTo(el, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 90%" } });
  });
  gsap.utils.toArray<HTMLElement>(".ac-card").forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.6, delay: i * 0.1, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 90%" } });
  });
</script>
