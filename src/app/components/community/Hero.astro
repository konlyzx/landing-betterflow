---
// Community hero section
---

<div class="relative">
<!-- Background layers — scoped to hero only -->
<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
  <!-- Mesh gradient background -->
  <img
    src="/mesh/red_comdistortion.webp"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-55"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Dark gradient overlay — fades mesh into solid dark at bottom -->
  <div
    class="absolute inset-0"
    style="background:linear-gradient(180deg, rgba(11,11,12,0.2) 0%, rgba(11,11,12,0.4) 30%, rgba(11,11,12,0.75) 65%, #0b0b0c 100%)"
  ></div>
  <!-- Brand glow orbs -->
  <div
    class="absolute top-[10%] left-1/2 -translate-x-1/2 h-[400px] w-[600px] rounded-full blur-[120px] opacity-20"
    style="background:radial-gradient(circle, #ff7e40 0%, transparent 70%)"
  ></div>
  <div
    class="absolute top-[20%] right-[15%] h-[250px] w-[250px] rounded-full blur-[90px] opacity-15"
    style="background:radial-gradient(circle, #a445ff 0%, transparent 70%)"
  ></div>
</div>

<section class="ch-section relative z-10 overflow-hidden px-6 pt-40 pb-20">

  <div class="relative z-10 mx-auto max-w-[860px] text-center">
    <!-- Badge -->
    <div
      class="ch-anim mb-6 inline-flex items-center gap-2.5 rounded-full px-4 py-1.5 text-xs font-medium"
      style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#ff7e40] opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#ff7e40]"></span>
      </span>
      <span style="color:rgba(255,255,255,0.7)">Community</span>
      <span style="color:rgba(255,255,255,0.2)">•</span>
      <span style="background:linear-gradient(135deg, #ff7e40 0%, #a445ff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Open Source</span>
    </div>

    <!-- Headline -->
    <div class="ch-anim">
      <h1 style="font-family:Geist, sans-serif;font-size:clamp(36px,5vw,60px);font-weight:600;color:#fff;letter-spacing:-0.035em;line-height:1.05;margin:0 0 16px">
        <span style="background:linear-gradient(135deg, #ff7e40 0%, #a445ff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Contribute</span><span class="text-white"> & Collaborate</span>
      </h1>
      <p style="font-family:'Geist Sans', sans-serif;font-size:17px;line-height:1.6;color:rgba(255,255,255,0.5);margin:0 auto;max-width:520px">
        Join the community shaping the future of BetterFlow. Contribute, discuss, and help build the best screenshot tool for developers and designers.
      </p>
    </div>

    <!-- CTAs -->
    <div class="ch-anim mt-4 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <a
        href="https://github.com/betterspacx"
        target="_blank"
        rel="noopener noreferrer"
        class="ch-btn inline-flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
        style="background:linear-gradient(110deg,#c9d4ff 0%,#e0d4ff 45%,#f5d4e8 100%);color:#000;box-shadow:inset 0 1px 0 rgba(255,255,255,0.7),0 1px 2px rgba(80,60,120,0.15);border-radius:64px;padding:14px 20px"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
        Star on GitHub
      </a>
      <a
        href="https://x.com/konlyzx_"
        target="_blank"
        rel="noopener noreferrer"
        class="ch-btn inline-flex items-center justify-center gap-2 text-sm font-medium transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
        style="background:linear-gradient(110deg,#c9d4ff 0%,#e0d4ff 45%,#f5d4e8 100%);color:#000;box-shadow:inset 0 1px 0 rgba(255,255,255,0.7),0 1px 2px rgba(80,60,120,0.15);border-radius:64px;padding:14px 20px"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        Follow Updates
      </a>
    </div>
  </div>
</section>
</div>

<style>
  .ch-btn { position: relative; overflow: hidden; }
  .ch-btn::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 1px;
    width: 120px;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.5) 50%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .ch-btn::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    height: 200px;
    width: 200px;
    transform: translate(-50%, -50%);
    background: conic-gradient(from 90deg at 50% 50%, transparent 50%, rgba(201,212,255,0.08) 50%), radial-gradient(rgba(201,212,255,0.12) 0%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .ch-btn:hover { translate: 0 -2px; }
  .ch-btn > * { position: relative; z-index: 1; }
</style>

<script>
  import { gsap } from "gsap";

  const els = gsap.utils.toArray<HTMLElement>(".ch-anim");
  els.forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.1 + i * 0.1 }
    );
  });
</script>
