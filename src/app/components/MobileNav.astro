---
interface Props {
  pathname?: string;
}
const { pathname = "" } = Astro.props;
const isDocs = pathname.startsWith("/docs");

const mainLinks = [
  { label: "Home", href: "/" },
  { label: "Features", href: "/#features" },
  { label: "Community", href: "/community" },
  { label: "Docs", href: "/docs" },
];

const docsLinks = [
  { section: "Getting Started", items: [{ name: "Introduction", href: "/docs" }] },
  {
    section: "Reference",
    items: [
      { name: "Architecture", href: "/docs/architecture" },
      { name: "Contributing", href: "/docs/contributing" },
      { name: "Changelog", href: "/docs/changelog" },
    ],
  },
];
---

<div id="mobile-nav-overlay" class="fixed inset-0 z-40 md:hidden hidden" aria-hidden="true">
  <div id="mobile-nav-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-md" data-close-menu></div>
  <nav id="mobile-nav-panel" class="mobile-nav-panel absolute right-0 top-0 h-full w-[280px] flex flex-col bg-[#0b0b0c]/95">
    <!-- Header: logo + close -->
    <div class="flex items-center justify-between px-5 h-12">
      <a href="/" class="flex items-center gap-2" data-close-menu>
        <img src="/logo.svg" alt="Better Flow" class="w-5 h-5" />
        <span class="text-[15px] font-semibold tracking-tight text-white" style="font-family:Geist,sans-serif">Better Flow</span>
      </a>
      <button id="mobile-nav-close" class="flex items-center justify-center w-8 h-8 rounded-full bg-white/[0.06] text-white/50 hover:text-white hover:bg-white/[0.1] transition-all duration-200" aria-label="Close menu">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <!-- Primary links -->
    <div class="flex flex-col px-4 py-4 gap-1">
      {mainLinks.map(({ label, href }) => {
        const active = pathname === href || (href !== "/" && pathname.startsWith(href));
        return (
          <a
            href={href}
            data-mobile-link={href}
            class={`px-3 py-2.5 text-[15px] rounded-lg transition-all duration-150 ${active ? "text-white bg-white/[0.06]" : "text-white/70 hover:text-white hover:bg-white/[0.04]"}`}
          >
            {label}
          </a>
        );
      })}
    </div>
    <!-- Docs sub-links -->
    {isDocs && (
      <div class="flex flex-col px-4 py-2 gap-1">
        <div class="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-white/25">Documentation</div>
        {docsLinks.map((group) => (
          <div class="flex flex-col gap-px">
            <div class="px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-white/30">{group.section}</div>
            {group.items.map((item) => (
              <a
                href={item.href}
                data-mobile-link={item.href}
                class={`px-3 py-2 text-[13px] rounded-lg transition-all duration-150 ${pathname === item.href ? "text-[#ff7e40] bg-white/[0.04]" : "text-white/50 hover:text-white/80 hover:bg-white/[0.03]"}`}
              >
                {item.name}
              </a>
            ))}
          </div>
        ))}
      </div>
    )}
    <!-- Spacer -->
    <div class="flex-1"></div>
    <!-- Bottom section -->
    <div class="border-t border-white/[0.04] px-4 py-5">
      <div class="flex flex-col gap-1 mb-5">
        <a href="/alternatives" class="px-3 py-2 text-[13px] text-white/40 hover:text-white/70 hover:bg-white/[0.04] rounded-lg transition-all duration-150" data-close-menu>Alternatives</a>
        <a href="/blog" class="px-3 py-2 text-[13px] text-white/40 hover:text-white/70 hover:bg-white/[0.04] rounded-lg transition-all duration-150" data-close-menu>Blog</a>
        <a href="mailto:hello@betterflow.site" class="px-3 py-2 text-[13px] text-white/40 hover:text-white/70 hover:bg-white/[0.04] rounded-lg transition-all duration-150">Contact</a>
      </div>
      <div class="flex items-center gap-4 px-3">
        <a href="https://github.com/betterspacx" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
        </a>
        <a href="https://x.com/konlyzx_" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="X / Twitter">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        </a>
        <a href="https://discord.gg/DypaXaseT4" target="_blank" rel="noopener noreferrer" class="text-white/40 hover:text-white transition-colors" aria-label="Discord">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.579.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"></path></svg>
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  .mobile-nav-panel {
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #mobile-nav-backdrop {
    opacity: 0;
    transition: opacity 0.28s ease;
  }
</style>

<script>
  const overlay = document.getElementById("mobile-nav-overlay");
  const panel = document.getElementById("mobile-nav-panel");
  const backdrop = document.getElementById("mobile-nav-backdrop");
  const closeBtn = document.getElementById("mobile-nav-close");

  function openMobileNav() {
    if (!overlay || !panel) return;
    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => {
      panel.style.transform = "translateX(0)";
      backdrop && (backdrop.style.opacity = "1");
    });
  }

  function closeMobileNav() {
    if (!overlay || !panel) return;
    panel.style.transform = "translateX(100%)";
    backdrop && (backdrop.style.opacity = "0");
    setTimeout(() => { overlay.classList.add("hidden"); }, 280);
    document.body.style.overflow = "";
  }

  backdrop?.addEventListener("click", closeMobileNav);
  closeBtn?.addEventListener("click", closeMobileNav);

  document.querySelectorAll<HTMLElement>("[data-mobile-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.dataset.mobileLink || "";
      if (href.startsWith("/#")) {
        e.preventDefault();
        closeMobileNav();
        window.location.href = href;
      } else {
        closeMobileNav();
      }
    });
  });

  document.addEventListener("docs-mobile-nav-open", openMobileNav);
  document.addEventListener("docs-mobile-nav-close", closeMobileNav);
</script>
