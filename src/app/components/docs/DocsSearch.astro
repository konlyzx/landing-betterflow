---
const items = [
  { title: "Introduction", description: "Overview, tech stack and quick start", href: "/docs", section: "Getting Started" },
  { title: "Architecture", description: "Codebase structure, routing, animation, Studio pipeline", href: "/docs/architecture", section: "Reference" },
  { title: "Contributing", description: "Setup, coding standards, PR workflow", href: "/docs/contributing", section: "Reference" },
  { title: "Changelog", description: "Version history and release notes", href: "/docs/changelog", section: "Reference" },
];
---

<button id="docs-search-trigger" class="relative flex items-center w-44 h-9 rounded-lg border border-white/[0.08] bg-white/[0.04] pl-9 pr-3 text-sm text-white/40 hover:border-white/20 hover:text-white/60 transition-all">
  <svg class="absolute left-2.5 h-4 w-4 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
  <span>Search</span>
  <kbd class="ml-auto text-[11px] text-white/30 font-medium hidden sm:block">⌘K</kbd>
</button>

<div id="docs-search-modal" class="fixed inset-0 z-[100] flex items-start justify-center bg-black/50 pt-[15vh] px-4 hidden">
  <div id="docs-search-modal-inner" class="w-full max-w-xl overflow-hidden rounded-xl border border-white/10 bg-[#0b0b0c] shadow-2xl">
    <div class="flex items-center gap-3 border-b border-white/[0.06] px-4">
      <svg class="h-4 w-4 text-white/40 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
      <input id="docs-search-input" type="text" placeholder="Search documentation..." class="w-full bg-transparent py-4 text-base text-white placeholder-white/30 focus:outline-none" style="caret-color: #ff7e40;" />
      <kbd class="text-[11px] text-white/40 border border-white/10 rounded px-2 py-1">ESC</kbd>
    </div>
    <div id="docs-search-results" class="max-h-[50vh] overflow-y-auto p-2">
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById("docs-search-trigger");
  const modal = document.getElementById("docs-search-modal");
  const modalInner = document.getElementById("docs-search-modal-inner");
  const input = document.getElementById("docs-search-input") as HTMLInputElement | null;
  const resultsContainer = document.getElementById("docs-search-results");

  const items = [
    { title: "Introduction", description: "Overview, tech stack and quick start", href: "/docs", section: "Getting Started" },
    { title: "Architecture", description: "Codebase structure, routing, animation, Studio pipeline", href: "/docs/architecture", section: "Reference" },
    { title: "Contributing", description: "Setup, coding standards, PR workflow", href: "/docs/contributing", section: "Reference" },
    { title: "Changelog", description: "Version history and release notes", href: "/docs/changelog", section: "Reference" },
  ];

  let activeIndex = 0;
  let currentResults = items;

  function getResults(query: string) {
    const q = query.trim().toLowerCase();
    if (!q) return items;
    return items.filter(
      (item) =>
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.section.toLowerCase().includes(q)
    );
  }

  function renderResults() {
    if (!resultsContainer) return;
    if (currentResults.length === 0) {
      const query = input?.value || "";
      resultsContainer.innerHTML = `<p class="px-4 py-8 text-center text-sm text-white/40">No results for "${query}"</p>`;
      return;
    }
    resultsContainer.innerHTML = currentResults
      .map(
        (item, i) => `
      <button data-href="${item.href}" data-index="${i}" class="docs-search-item flex w-full items-center gap-3 rounded-lg px-4 py-3 text-left transition-colors ${activeIndex === i ? "bg-[#ff7e40]/10" : "hover:bg-white/[0.04]"}">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium ${activeIndex === i ? "text-[#ff7e40]" : "text-white/90"}">${item.title}</span>
            <span class="text-[10px] uppercase tracking-wider text-white/30">${item.section}</span>
          </div>
          <p class="truncate text-xs text-white/40 mt-0.5">${item.description}</p>
        </div>
        ${activeIndex === i ? '<svg class="h-3.5 w-3.5 text-white/30 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4l7-7"></path></svg>' : ""}
      </button>`
      )
      .join("");
  }

  function open() {
    modal?.classList.remove("hidden");
    setTimeout(() => input?.focus(), 50);
    activeIndex = 0;
    currentResults = items;
    renderResults();
  }

  function close() {
    modal?.classList.add("hidden");
    if (input) input.value = "";
    activeIndex = 0;
  }

  function go(href: string) {
    close();
    window.location.href = href;
  }

  trigger?.addEventListener("click", open);

  document.addEventListener("mousedown", (e) => {
    if (modal?.classList.contains("hidden")) return;
    if (modalInner && !modalInner.contains(e.target as Node)) close();
  });

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (modal?.classList.contains("hidden")) open();
      else close();
    }
    if (e.key === "Escape") close();
  });

  input?.addEventListener("input", () => {
    currentResults = getResults(input.value);
    activeIndex = 0;
    renderResults();
  });

  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
      renderResults();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      renderResults();
    } else if (e.key === "Enter" && currentResults[activeIndex]) {
      e.preventDefault();
      go(currentResults[activeIndex].href);
    }
  });

  resultsContainer?.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(".docs-search-item") as HTMLElement | null;
    if (target) {
      const href = target.dataset.href;
      if (href) go(href);
    }
  });

  resultsContainer?.addEventListener("mouseover", (e) => {
    const target = (e.target as HTMLElement).closest(".docs-search-item") as HTMLElement | null;
    if (target && target.dataset.index !== undefined) {
      activeIndex = parseInt(target.dataset.index, 10);
      renderResults();
    }
  });
</script>
