<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const navbarEl = document.getElementById('main-navbar') as HTMLElement | null;
  const navbar = document.querySelector('.navbar-inner') as HTMLElement | null;
  if (navbarEl) {
    ScrollTrigger.create({
      start: 10,
      onEnter() { navbar?.classList.add('scrolled'); },
      onLeaveBack() { navbar?.classList.remove('scrolled'); },
    });
  }

  const toggle = document.querySelector('.mobile-menu-toggle');
  const overlay = document.querySelector('.mobile-nav-overlay') as HTMLElement | null;
  const panel = document.querySelector('.mobile-nav-panel') as HTMLElement | null;
  const closeTargets = document.querySelectorAll('[data-close-menu], .mobile-menu-close');
  let open = false;

  function setMenu(isOpen: boolean) {
    open = isOpen;
    if (!toggle || !overlay || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    overlay.setAttribute('aria-hidden', String(!open));
    const bars = toggle.querySelectorAll('span');
    if (open) {
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        panel.style.transform = 'translateX(0)';
        (overlay.querySelector('.mobile-nav-backdrop') as HTMLElement).style.opacity = '1';
      });
      bars[0]?.classList.add('rotate-45', 'translate-y-[3px]');
      bars[1]?.classList.add('-rotate-45', '-translate-y-[3px]');
    } else {
      panel.style.transform = 'translateX(100%)';
      (overlay.querySelector('.mobile-nav-backdrop') as HTMLElement).style.opacity = '0';
      setTimeout(() => { overlay.classList.add('hidden'); }, 280);
      document.body.style.overflow = '';
      bars[0]?.classList.remove('rotate-45', 'translate-y-[3px]');
      bars[1]?.classList.remove('-rotate-45', '-translate-y-[3px]');
    }
  }

  toggle?.addEventListener('click', () => setMenu(!open));
  closeTargets.forEach((el) => el.addEventListener('click', () => setMenu(false)));

  const links = document.querySelectorAll('.nav-link');
  const highlight = document.querySelector('.nav-highlight') as HTMLElement | null;
  const container = document.querySelector('.nav-links') as HTMLElement | null;

  function positionHighlight(el: HTMLElement) {
    if (!highlight || !container) return;
    const linkRect = el.getBoundingClientRect();
    const containerRect = container.getBoundingClientRect();
    highlight.style.width = `${linkRect.width}px`;
    highlight.style.height = `${linkRect.height}px`;
    highlight.style.transform = `translateX(${linkRect.left - containerRect.left}px)`;
    highlight.style.opacity = '1';
  }

  links.forEach((link) => {
    link.addEventListener('mouseenter', () => positionHighlight(link as HTMLElement));
  });
  container?.addEventListener('mouseleave', () => {
    if (highlight) highlight.style.opacity = '0';
  });
</script>

<style>
  .navbar {
    transition: none;
  }
  .navbar-inner {
    max-width: 100%;
    position: relative;
  }
  .navbar-content {
    max-width: 1400px;
  }
  .navbar-content { position: relative; z-index: 1; }
  .mobile-nav-panel {
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-nav-backdrop {
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .nav-sponsor-btn { position: relative; overflow: hidden; }
  .nav-sponsor-btn::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    height: 1px;
    width: 100px;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.5) 50%, transparent 100%);
    pointer-events: none;
    z-index: 2;
  }
  .nav-sponsor-btn::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    height: 160px;
    width: 160px;
    transform: translate(-50%, -50%);
    background: conic-gradient(from 90deg at 50% 50%, transparent 50%, rgba(244,63,94,0.08) 50%), radial-gradient(rgba(244,63,94,0.12) 0%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .nav-sponsor-btn:hover { translate: 0 -2px; }
  .nav-sponsor-btn > * { position: relative; z-index: 1; }
</style>
