---
const links = [
  { label: "Features", href: "/#features" },
  { label: "Community", href: "/community" },
  { label: "Docs", href: "/docs" },
  { label: "Roadmap", href: "/#roadmap" },
  { label: "Privacy", href: "/#privacy" },
];
---

<div
  id="quick-nav"
  class="pointer-events-none fixed inset-x-0 bottom-0 hidden items-center justify-between px-10 py-4 md:flex"
  style="z-index:55"
>
  <nav class="pointer-events-auto flex items-center gap-6">
    {
      links.map(({ label, href }) => (
        <a
          href={href}
          class="text-[12px] font-medium tracking-wide text-white/40 transition-colors duration-200 hover:text-white/80"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <div class="pointer-events-auto flex items-center gap-4">
    <a
      href="https://github.com/betterspacx"
      target="_blank"
      rel="noopener noreferrer"
      class="text-white/40 transition-colors duration-200 hover:text-white/80"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
    <a
      href="https://x.com/konlyzx_"
      target="_blank"
      rel="noopener noreferrer"
      class="text-white/40 transition-colors duration-200 hover:text-white/80"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </a>
    <a
      href="https://github.com/betterspacx"
      target="_blank"
      rel="noopener noreferrer"
      class="group hidden h-8 w-8 items-center justify-center rounded-lg text-white/50 transition-all duration-300 hover:scale-110 hover:text-white md:flex"
    >
      <svg
        class="h-4 w-4 transition-transform duration-300 group-hover:rotate-[360deg]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const nav = document.getElementById("quick-nav");
  if (nav) {
    ScrollTrigger.create({
      start: "80px top",
      onEnter: () => {
        gsap.to(nav, { opacity: 0, y: 10, duration: 0.4, ease: "power2.in" });
      },
      onLeaveBack: () => {
        gsap.to(nav, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" });
      },
    });
  }
</script>
