---
interface Milestone {
  version: string;
  displayNum: string;
  timing: string;
  status: "done" | "now" | "planned";
  variant?: "surprise";
  title: string;
  changes: string[];
}

const MILESTONES: Milestone[] = [
  { version: "v0.1", displayNum: "1", timing: "DONE", status: "done", title: "Landing Page", changes: ["Public website", "Feature showcase", "Waitlist signup"] },
  { version: "v0.2", displayNum: "2", timing: "DONE", status: "done", title: "Studio Launch", changes: ["Create polished screenshots", "Browser frames", "Motion exports", "4K output"] },
  { version: "v0.3", displayNum: "3", timing: "NOW", status: "now", variant: "surprise", title: "Surprise Release 👀", changes: ["Invite-only feature", "New creation workflow", "Hidden until launch"] },
  { version: "v0.4", displayNum: "4", timing: "LATER", status: "planned", title: "Chrome Extension", changes: ["Capture → Edit → Export"] },
];
---

<section class="relative z-10 px-6 py-28">
  <div class="mx-auto max-w-[1324px]">
    <div class="rm-reveal mb-16">
      <span class="text-xs font-medium tracking-widest text-[#71717a] uppercase">Roadmap</span>
      <h2 style="font-family:Geist, sans-serif;font-size:32px;font-weight:500;color:#fff;letter-spacing:-0.02em;margin:16px 0 0">What's next for Better Flow</h2>
    </div>

    <!-- Desktop: horizontal timeline -->
    <div class="hidden md:block">
      <!-- Timeline rail -->
      <div class="relative mb-10">
        <div
          class="absolute top-[28px] left-[12.5%] right-[12.5%] h-px"
          style="background:linear-gradient(90deg, rgba(52,211,153,0.5) 0%, rgba(52,211,153,0.5) 37.5%, rgba(164,69,255,0.5) 62.5%, rgba(82,82,91,0.3) 87.5%)"
        ></div>
        <div class="grid grid-cols-4">
          {MILESTONES.map((m) => {
            const isNow = m.status === "now";
            const isDone = m.status === "done";
            const isSurprise = m.variant === "surprise";
            const accentColor = isSurprise ? "#a445ff" : isNow ? "#c9d4ff" : isDone ? "#34d399" : "#52525b";
            return (
              <div class="rm-node relative flex flex-col items-center">
                <span class="mb-2 text-[11px] font-semibold tracking-wider" style={`color:${isSurprise ? "#c084fc" : isNow ? "#c9d4ff" : isDone ? "#34d399" : "#a1a1aa"}`}>{m.timing}</span>
                <div class="relative z-10">
                  <div class="h-3 w-3 rounded-full shadow-[0_0_8px_rgba(255,255,255,0.15)]" style={`background-color:${accentColor}`}>
                    {(isNow || isSurprise) && (
                      <div class="absolute -inset-1 animate-pulse rounded-full border" style={`border-color:${isSurprise ? "rgba(164,69,255,0.5)" : "rgba(201,212,255,0.4)"}`}></div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Cards -->
      <div class="grid grid-cols-4 gap-4">
        {MILESTONES.map((m) => {
          const isNow = m.status === "now";
          const isDone = m.status === "done";
          const isSurprise = m.variant === "surprise";
          const isChrome = m.title === "Chrome Extension";
          const glowColor = isSurprise ? "rgba(164,69,255,0.12)" : isNow ? "rgba(201,212,255,0.1)" : isDone ? "rgba(52,211,153,0.08)" : "rgba(255,255,255,0.04)";
          return (
            <div class="rm-item relative flex">
              <div class="relative flex-1 overflow-hidden rounded-2xl border-t border-white/[0.08] bg-[#131316] p-5 text-left">
                <div class="pointer-events-none absolute left-1/2 top-0 h-px w-[120px] -translate-x-1/2 -translate-y-1/2" style="background:linear-gradient(90deg, transparent 0%, rgba(143,143,143,0.67) 50%, transparent 100%)"></div>
                <div class="pointer-events-none absolute -top-1 left-1/2 h-[300px] w-[280px] -translate-x-1/2 -translate-y-1/2" style={`background:conic-gradient(from 90deg at 50% 50%, transparent 50%, #131316 50%), radial-gradient(${glowColor} 0%, transparent 80%)`}></div>

                <div class="relative">
                  <div class="mb-3 flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.1] bg-white/[0.05] px-2.5 py-1 text-[11px] font-medium text-white/60">{m.version}</span>
                    {isNow && <span class="inline-flex items-center gap-1.5 rounded-full border border-[#c9d4ff]/20 bg-[#c9d4ff]/5 px-2.5 py-1 text-[11px] font-medium text-[#c9d4ff]/70">In Progress</span>}
                    {isDone && <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-2.5 py-1 text-[11px] font-medium text-emerald-400/70">Shipped</span>}
                    {isSurprise && <span class="inline-flex items-center gap-1.5 rounded-full border border-[#a445ff]/20 bg-[#a445ff]/5 px-2.5 py-1 text-[11px] font-medium text-[#c084fc]/70">Surprise</span>}
                  </div>

                  <h3 class="mb-4 text-lg font-bold tracking-tight text-white">{m.title}</h3>

                  <div>
                    {isChrome ? (
                      <div class="flex items-center gap-2 text-sm flex-wrap">
                        {m.changes[0].split(" → ").map((step, si, arr) => (
                          <span class="flex items-center gap-2">
                            <span class="inline-flex items-center rounded-md border border-white/[0.1] bg-white/[0.05] px-2.5 py-1 text-xs font-medium tracking-wide text-white/75">{step}</span>
                            {si < arr.length - 1 && <span class="text-white/20">→</span>}
                          </span>
                        ))}
                      </div>
                    ) : (
                      <ul class="flex flex-col gap-2">
                        {m.changes.map((change) => (
                          <li class="flex items-center gap-2.5 text-[13px] text-white/60">
                            <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full" style={`background:${isSurprise ? "rgba(164,69,255,0.1)" : isNow ? "rgba(201,212,255,0.1)" : isDone ? "rgba(52,211,153,0.1)" : "rgba(255,255,255,0.05)"}`}>
                              <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style={`color:${isSurprise ? "#c084fc" : isNow ? "#c9d4ff" : isDone ? "#34d399" : "#71717a"}`}><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                            {change}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Mobile: vertical stack -->
    <div class="md:hidden">
      <div class="flex flex-col gap-4">
        {MILESTONES.map((m) => {
          const isNow = m.status === "now";
          const isDone = m.status === "done";
          const isSurprise = m.variant === "surprise";
          const isChrome = m.title === "Chrome Extension";
          const glowColor = isSurprise ? "rgba(164,69,255,0.12)" : isNow ? "rgba(201,212,255,0.1)" : isDone ? "rgba(52,211,153,0.08)" : "rgba(255,255,255,0.04)";
          return (
            <div class="rm-item relative overflow-hidden rounded-2xl border-t border-white/[0.08] bg-[#131316] p-5 text-left">
              <div class="pointer-events-none absolute left-1/2 top-0 h-px w-[120px] -translate-x-1/2 -translate-y-1/2" style="background:linear-gradient(90deg, transparent 0%, rgba(143,143,143,0.67) 50%, transparent 100%)"></div>
              <div class="pointer-events-none absolute -top-1 left-1/2 h-[300px] w-[280px] -translate-x-1/2 -translate-y-1/2" style={`background:conic-gradient(from 90deg at 50% 50%, transparent 50%, #131316 50%), radial-gradient(${glowColor} 0%, transparent 80%)`}></div>

              <div class="relative">
                <div class="mb-3 flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.1] bg-white/[0.05] px-2.5 py-1 text-[11px] font-medium text-white/60">{m.version}</span>
                  {isNow && <span class="inline-flex items-center gap-1.5 rounded-full border border-[#c9d4ff]/20 bg-[#c9d4ff]/5 px-2.5 py-1 text-[11px] font-medium text-[#c9d4ff]/70">In Progress</span>}
                  {isDone && <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-2.5 py-1 text-[11px] font-medium text-emerald-400/70">Shipped</span>}
                  {isSurprise && <span class="inline-flex items-center gap-1.5 rounded-full border border-[#a445ff]/20 bg-[#a445ff]/5 px-2.5 py-1 text-[11px] font-medium text-[#c084fc]/70">Surprise</span>}
                </div>

                <h3 class="mb-4 text-lg font-bold tracking-tight text-white">{m.title}</h3>

                <div>
                  {isChrome ? (
                    <div class="flex items-center gap-2 text-sm flex-wrap">
                      {m.changes[0].split(" → ").map((step, si, arr) => (
                        <span class="flex items-center gap-2">
                          <span class="inline-flex items-center rounded-md border border-white/[0.1] bg-white/[0.05] px-2.5 py-1 text-xs font-medium tracking-wide text-white/75">{step}</span>
                          {si < arr.length - 1 && <span class="text-white/20">→</span>}
                        </span>
                      ))}
                    </div>
                  ) : (
                    <ul class="flex flex-col gap-2">
                      {m.changes.map((change) => (
                        <li class="flex items-center gap-2.5 text-[13px] text-white/60">
                          <div class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full" style={`background:${isSurprise ? "rgba(164,69,255,0.1)" : isNow ? "rgba(201,212,255,0.1)" : isDone ? "rgba(52,211,153,0.1)" : "rgba(255,255,255,0.05)"}`}>
                            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style={`color:${isSurprise ? "#c084fc" : isNow ? "#c9d4ff" : isDone ? "#34d399" : "#71717a"}`}><polyline points="20 6 9 17 4 12"></polyline></svg>
                          </div>
                          {change}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>(".rm-reveal").forEach((el) => {
    gsap.fromTo(el, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 88%" } });
  });
  gsap.utils.toArray<HTMLElement>(".rm-item").forEach((el, i) => {
    gsap.fromTo(el, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.5, delay: i * 0.08, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 90%" } });
  });
</script>
