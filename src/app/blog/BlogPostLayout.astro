---
export interface Props {
  title: string;
  description: string;
  publishedDate: string;
  readTime: string;
  category: string;
}

import Navbar from "@/app/components/Navbar.astro";
import Footer from "@/app/components/Footer.astro";

const { title, description, publishedDate, readTime, category } = Astro.props;
---

<Navbar />

<main class="relative min-h-screen bg-[#0b0b0c]">
  <article class="relative z-10 mx-auto max-w-[720px] px-6 pt-36 pb-24">
    <!-- Meta -->
    <div class="mb-8 flex flex-wrap items-center gap-3">
      <span
        class="rounded-full px-3 py-1 text-xs font-medium"
        style="background:rgba(255,126,64,0.12);color:#ff7e40;border:1px solid rgba(255,126,64,0.2)"
      >
        {category}
      </span>
      <span style="font-family:'Geist Sans', sans-serif;font-size:12px;color:rgba(255,255,255,0.3)">{publishedDate}</span>
      <span style="color:rgba(255,255,255,0.15)">·</span>
      <span style="font-family:'Geist Sans', sans-serif;font-size:12px;color:rgba(255,255,255,0.3)">{readTime} read</span>
    </div>

    <!-- Title -->
    <h1
      style="font-family:Geist, sans-serif;font-size:clamp(28px,4vw,44px);font-weight:600;color:#fff;letter-spacing:-0.035em;line-height:1.1;margin:0 0 20px"
    >
      {title}
    </h1>
    <p style="font-family:'Geist Sans', sans-serif;font-size:17px;line-height:1.65;color:rgba(255,255,255,0.5);margin:0 0 48px;border-bottom:1px solid rgba(255,255,255,0.06);padding-bottom:48px">
      {description}
    </p>

    <!-- Content -->
    <div class="blog-content">
      <slot />
    </div>

    <!-- CTA -->
    <div class="mt-20 rounded-2xl p-8 text-center" style="background:#131316;border:none;border-top:1px solid rgba(255,126,64,0.2)">
      <h3 style="font-family:Geist, sans-serif;font-size:22px;font-weight:600;color:#fff;letter-spacing:-0.02em;margin:0 0 10px">
        Try Better Flow for free
      </h3>
      <p style="font-family:'Geist Sans', sans-serif;font-size:14px;color:rgba(255,255,255,0.5);margin:0 0 24px">
        No account, no uploads, no watermarks. Open source screenshot studio.
      </p>
      <a
        href="https://app.betterflow.site/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium transition-all duration-200 hover:scale-[1.02]"
        style="background:linear-gradient(110deg,#c9d4ff 0%,#e0d4ff 45%,#f5d4e8 100%);color:#000;border-radius:64px;padding:14px 24px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.7)"
      >
        Open Better Flow →
      </a>
    </div>
  </article>

  <Footer />
</main>

<style is:global>
  .blog-content h2 {
    font-family: Geist, sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
    margin: 40px 0 14px;
  }
  .blog-content h3 {
    font-family: Geist, sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: rgba(255,255,255,0.9);
    letter-spacing: -0.01em;
    margin: 28px 0 10px;
  }
  .blog-content p {
    font-family: 'Geist Sans', sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255,255,255,0.6);
    margin: 0 0 18px;
  }
  .blog-content ul, .blog-content ol {
    font-family: 'Geist Sans', sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(255,255,255,0.6);
    margin: 0 0 18px;
    padding-left: 24px;
  }
  .blog-content li { margin-bottom: 6px; }
  .blog-content strong { color: rgba(255,255,255,0.85); font-weight: 600; }
  .blog-content a { color: #ff7e40; text-decoration: underline; text-underline-offset: 3px; }
  .blog-content a:hover { color: #ffab80; }
  .blog-content code {
    font-family: 'Geist Mono', monospace;
    font-size: 13px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 4px;
    padding: 1px 6px;
    color: rgba(255,255,255,0.85);
  }
  .blog-content hr {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.07);
    margin: 36px 0;
  }
  .blog-content blockquote {
    border-left: 3px solid rgba(255,126,64,0.4);
    padding-left: 20px;
    margin: 24px 0;
    color: rgba(255,255,255,0.5);
    font-style: italic;
  }
  .blog-content figure {
    margin: 28px 0;
  }
  .blog-content figcaption {
    font-family: 'Geist Sans', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.35);
    text-align: center;
    margin-top: 8px;
  }
</style>
