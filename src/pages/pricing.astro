---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/app/components/Navbar.astro';
import Footer from '@/app/components/Footer.astro';
---

<Layout
  title="Pricing — Better Flow"
  description="Start for free, upgrade to Cloud for \$10/month."
  canonical="/pricing/"
>
  <Navbar />

  <main class="flex-1">
    <section class="relative overflow-hidden px-4 pt-32 pb-24">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
            Simple, transparent pricing
          </h1>
          <p class="text-lg text-zinc-400">
            Start for free, upgrade when you need more.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          <!-- Free Plan -->
          <div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-8 flex flex-col">
            <h2 class="text-xl font-semibold mb-2">Free</h2>
            <p class="text-sm text-zinc-400 mb-6">For casual users</p>
            <div class="text-3xl font-bold mb-8">$0</div>
            <ul class="space-y-3 mb-8 flex-1 text-sm text-zinc-300">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                All editing features
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Unlimited exports (PNG, JPG)
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Up to 2x export scale
              </li>
              <li class="flex items-center gap-2 text-zinc-500">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                Video export
              </li>
            </ul>
            <a href="https://app.betterflow.site" class="inline-flex items-center justify-center w-full h-11 rounded-xl border border-zinc-700 bg-zinc-800 text-sm font-medium hover:bg-zinc-700 transition-colors">
              Get Started
            </a>
          </div>

          <!-- Cloud Plan -->
          <div class="rounded-2xl border border-blue-500/30 bg-zinc-900/50 p-8 flex flex-col relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-blue-500 text-xs font-semibold rounded-full text-white">
              Popular
            </div>
            <h2 class="text-xl font-semibold mb-2">Cloud</h2>
            <p class="text-sm text-zinc-400 mb-6">For professionals</p>
            <div class="text-3xl font-bold mb-1">$10</div>
            <p class="text-sm text-zinc-500 mb-8">per month</p>
            <ul class="space-y-3 mb-8 flex-1 text-sm text-zinc-300">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Everything in Free
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Video export (MP4, WebM, GIF)
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Up to 5x export scale
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Priority support
              </li>
            </ul>
            <a href="https://app.betterflow.site/login" class="inline-flex items-center justify-center w-full h-11 rounded-xl bg-blue-500 text-sm font-medium text-white hover:bg-blue-400 transition-colors">
              Subscribe
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
